{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/api/trips/:id",
      "destination": "/api/trips?id=:id"
    },
    {
      "source": "/api/users/login",
      "destination": "/api/users?action=login"
    },
    {
      "source": "/api/users/:id",
      "destination": "/api/users?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*\\.js|pwa-.*\\.png|apple-touch-icon\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
